import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

/**
 * Tests for Course: constructor validation and getters.
 * Note: because the constructor rejects bad input up front, a Course can
 * never exist "uninitialized" — so the bad-input getter cases are proven
 * by showing construction itself throws instead.
 */
class CourseTest {

    // --- Constructor: normal case ---
    @Test
    void testValidCourseCreation() {
        Course c = new Course("CS 2114", 12345, "MWF 9:00AM");
        assertEquals("CS 2114", c.getCourseName());
        assertEquals(12345, c.getCourseNumber());
        assertEquals("MWF 9:00AM", c.getTime());
    }

    // --- Constructor: bad-input cases ---
    @Test
    void testBlankCourseNameThrows() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course("", 12345, "MWF 9:00AM"));
    }

    @Test
    void testNullCourseNameThrows() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course(null, 12345, "MWF 9:00AM"));
    }

    @Test
    void testNonPositiveCourseNumberThrows() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course("CS 2114", 0, "MWF 9:00AM"));
    }

    @Test
    void testInvalidTimeFormatThrows() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course("CS 2114", 12345, "whenever"));
    }

    @Test
    void testNullTimeThrows() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course("CS 2114", 12345, null));
    }

    // --- getCourseName(): normal + bad ---
    @Test
    void testGetCourseNameNormal() {
        Course c = new Course("CS 3114", 54321, "TR 11:00AM");
        assertEquals("CS 3114", c.getCourseName());
    }

    @Test
    void testGetCourseNameBadInputPreventsCreation() {
        // "Bad" object never exists; constructor guards it instead
        assertThrows(IllegalArgumentException.class,
                () -> new Course("", 54321, "TR 11:00AM"));
    }

    // --- getCourseNumber(): normal + bad ---
    @Test
    void testGetCourseNumberNormal() {
        Course c = new Course("CS 3114", 54321, "TR 11:00AM");
        assertEquals(54321, c.getCourseNumber());
    }

    @Test
    void testGetCourseNumberBadInputPreventsCreation() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course("CS 3114", -1, "TR 11:00AM"));
    }

    // --- getTime(): normal + bad ---
    @Test
    void testGetTimeNormal() {
        Course c = new Course("CS 3114", 54321, "TR 11:00AM");
        assertEquals("TR 11:00AM", c.getTime());
    }

    @Test
    void testGetTimeBadInputPreventsCreation() {
        assertThrows(IllegalArgumentException.class,
                () -> new Course("CS 3114", 54321, "sometime"));
    }
}